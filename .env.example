# Telegram Bot API
BOT_TOKEN=

# Telegram API / MTProto
API_ID=
API_HASH=

# Application owner / support
OWNER_TELEGRAM_ID=
SUPPORT_TELEGRAM_ID=

# Database
DATABASE_URL=postgresql+asyncpg://kronos:kronos@postgres:5432/kronos

# Redis
REDIS_URL=redis://redis:6379/0

# Application security
SECRET_KEY=

# Public Mini App origin (without /miniapp/)
WEBAPP_URL=https://example.com

# Runtime storage
SESSIONS_DIR=/data/sessions
MEDIA_DIR=/data/media

# Scheduler
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL=3600
UPLOAD_MAX_MB=50
SCHEDULER_POLL_SECONDS=2
SCHEDULER_BATCH_SIZE=20
SCHEDULER_RETRY_DELAY_SECONDS=60
SUPPORT_MAX_ACTIVE_TICKETS=2
SUPPORT_MAX_ATTACHMENT_MB=8

# Cloudflare Tunnel
# Keep this variable in the local .env only.
# It is intentionally not passed to application containers.
CLOUDFLARE_TUNNEL_TOKEN=
